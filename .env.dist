# Template for the local .env file: `cp .env.dist .env` and adjust values.
# .env itself is never committed.

# Deployment mode: "development" enables /docs and uvicorn --reload; "production" does not.
ENVIRONMENT=development

# Verbosity of the application log written to stdout.
# One of: CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# Async SQLAlchemy URL for the application database (psycopg 3 driver).
# Used by both the app and Alembic. Host/port/credentials must match the
# "postgres" Compose service; change both places or neither.
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/application

# Redis connection URL; used exclusively as the Taskiq broker.
# The "redis" host is the Compose service of the same name.
REDIS_URL=redis://redis:6379/0

# Directory for retained ingestion payloads (raw fetched HTML). Inside the
# container this is part of the ./backend bind mount, so the files show up
# under backend/var/data on the host (gitignored).
DATA_DIR=/app/var/data

# Per-request timeout for outbound source fetches, in seconds.
INGESTION_FETCH_TIMEOUT_SECONDS=20

# Hard ceiling on a single fetched response body, in bytes (5 MiB). The
# download is aborted as soon as it exceeds this.
INGESTION_MAX_FETCH_BYTES=5242880
