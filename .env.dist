# Template for the local .env file: `cp .env.dist .env` and adjust values.
# .env itself is never committed.

# Deployment mode: "development" enables /docs and uvicorn --reload; "production" does not.
ENVIRONMENT=development

# Verbosity of the application log written to stdout.
# One of: CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# Async SQLAlchemy URL for the application database (psycopg 3 driver).
# Used by both the app and Alembic. Host/port/credentials must match the
# "postgres" Compose service; change both places or neither.
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/application

# Redis connection URL; used exclusively as the Taskiq broker.
# The "redis" host is the Compose service of the same name.
REDIS_URL=redis://redis:6379/0

# Directory for retained ingestion payloads (raw fetched HTML). Inside the
# container this is part of the ./backend bind mount, so the files show up
# under backend/var/data on the host (gitignored).
DATA_DIR=/app/var/data

# Directory for downloaded product images and their generated variants. Also
# part of the ./backend bind mount (host: backend/var/media, gitignored) and
# served publicly, read-only, under /media.
MEDIA_DIR=/app/var/media

# Per-request timeout for outbound source fetches, in seconds.
INGESTION_FETCH_TIMEOUT_SECONDS=20

# Hard ceiling on a single fetched response body, in bytes (5 MiB). The
# download is aborted as soon as it exceeds this.
INGESTION_MAX_FETCH_BYTES=5242880

# Web search backend used to find product, technical and review pages.
# Supported values: tavily | openrouter. Pick openrouter to run without a
# Tavily account (it reuses OPENROUTER_API_KEY and CHAT_MODEL via OpenRouter's
# web plugin, at roughly $0.01-0.02 per query instead of one Tavily credit).
SEARCH_PROVIDER=tavily

# API key for Tavily (https://app.tavily.com — free tier: 1000 credits/month,
# one credit per basic search). Left empty here: without it ingestion runs
# Wikipedia-only and appends a warning instead of failing.
TAVILY_API_KEY=

# Maximum number of web pages (Wikipedia excluded) one ingestion run fetches.
INGESTION_MAX_WEB_DOCUMENTS=6

# OpenRouter is the only LLM gateway (chat and embeddings). Create a key at
# https://openrouter.ai/keys. Left empty here: without it the application still
# starts, and every model call reports the missing key instead of failing
# obscurely.
OPENROUTER_API_KEY=

# Default chat model, as an OpenRouter model identifier. Used by ingestion,
# specification extraction and the utility calls (never by the advisor).
CHAT_MODEL=openai/gpt-4.1-mini

# The model the customer-facing advisor speaks with (the chat responder and its
# tool-calling loop), as an OpenRouter model identifier. Separate from
# CHAT_MODEL so the conversation can be upgraded without changing the cost of
# the catalogue pipeline.
ADVISOR_MODEL=openai/gpt-4.1-mini

# Embedding model, as an OpenRouter model identifier. Its native vector size is
# 1536; no `dimensions` parameter is ever sent.
EMBEDDING_MODEL=openai/text-embedding-3-small

# Width of the vectors the embedding model returns. This must equal the
# `vector(n)` width of the `chunks.embedding` column: changing the model to one
# with a different size requires a migration that alters that column, and the
# embedding pass refuses to run until both agree.
EMBEDDING_DIMENSIONS=1536

# Character budget one specification extraction may spend on source documents
# (Wikipedia first, each document head-truncated to 12000 characters). Chosen
# character-based on purpose: no tokenizer dependency.
EXTRACTION_MAX_INPUT_CHARS=60000

# Target size of one retrievable chunk, in characters (~800 tokens). Sections
# shorter than this stay whole; longer ones are split at paragraph boundaries.
CHUNK_SIZE_CHARS=3200

# Characters repeated from the end of one chunk at the start of the next, so a
# statement split across the boundary is still retrievable from both sides.
CHUNK_OVERLAP_CHARS=400

# Reciprocal Rank Fusion constant of hybrid retrieval: each leg contributes
# 1 / (RRF_K + rank). Larger values flatten the advantage of the top ranks and
# reward chunks that both legs found; 60 is the value the RRF paper uses.
RRF_K=60

# How many candidates the full-text leg and the vector leg each contribute
# before fusion. Higher costs a little more index work per search and gives the
# fusion more chances to find agreement between the two legs.
RETRIEVAL_CANDIDATES_PER_LEG=50

# How many rounds of tool calls the advisor's agent loop may spend on one turn.
# When the budget is used up the loop asks the model once more with the tools
# unbound, so the customer always gets an answer instead of a spinning loop.
AGENT_MAX_TOOL_STEPS=8

# Hard wall-clock limit for one advisor turn, in seconds (model calls, tool
# calls and retrieval together). Exceeding it ends the turn with the apologetic
# message and a failed operation. The API considers a turn lost 30 seconds
# later (the frontend mirrors that sum as CHAT_TURN_STALE_SECONDS = 150), so
# changing this value means changing the frontend constant too.
AGENT_TIMEOUT_SECONDS=120
